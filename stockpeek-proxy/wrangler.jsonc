{
  // Production Cloudflare Worker configuration. No credentials in source.
  "name": "stockpeek-proxy",
  "main": "./src/worker.js",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  // Explicit non-secret runtime configuration, versioned with deploy source.
  "vars": {
    "ANALYSIS_ENABLED": "0",
    "ANALYSIS_DAILY_LIMIT": "3",
    "P4_MODEL": "anthropic/claude-sonnet-5.5",
    "SEC_USER_AGENT": "StockPeek/1.0 (sngmng6506@gmail.com)"
  },
  "d1_databases": [
    {
      "binding": "ANALYSIS_DB",
      "database_name": "stock-peek",
      "database_id": "22cd62c8-82f0-4708-9849-4fce7c952ce4"
    }
  ]
}
